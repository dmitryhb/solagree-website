{
  "name": "solagree-website",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "nuxt dev --host solagree.local --port 3003",
    "deploy:staging": "./scripts/deploy-staging.sh",
    "deploy:production": "./scripts/deploy-production.sh",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "preview": "nuxt preview --host solagree.local --port 3003",
    "test:co-branded-page-variants": "node --experimental-strip-types --test tests/co-branded-page-variant.test.mts",
    "test:co-branded-consult-requests": "node --experimental-strip-types --test tests/co-branded-consult-request.test.mts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/ui": "^4.6.1",
    "handlebars": "^4.7.9",
    "nuxt": "^4.4.2",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.4",
    "sass": "^1.99.0",
    "vue-tsc": "^3.2.7"
  }
}
