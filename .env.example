NUXT_PUBLIC_SITE_URL=http://solagree.local:3003
NUXT_PUBLIC_GA_MEASUREMENT_ID=G-TCGL2PDNNY
# Development fallback: http://solagree-portal.local:3004
# Production should set this to the deployed portal web origin.
NUXT_PUBLIC_PORTAL_URL=http://solagree-portal.local:3004
# Production must set this to the deployed portal API origin.
NUXT_PUBLIC_PORTAL_API_BASE_URL=http://solagree-portal.local:3004
# Cal.com event paths (not full URLs). Only published consultants require paths.
# Keep mixed until the separate Phone/Zoom provider routes are ready and release is approved.
NUXT_PUBLIC_CALCOM_INITIAL_CONSULT_MEETING_METHOD_MODE=mixed
# These existing paths become Zoom-only routes in separate mode.
NUXT_PUBLIC_CALCOM_INITIAL_CONSULT_FIRST_AVAILABLE_EVENT_PATH=initial-consults/initial-consult
NUXT_PUBLIC_CALCOM_INITIAL_CONSULT_TAJ_EVENT_PATH=initial-consults/initial-consult-taj
NUXT_PUBLIC_CALCOM_INITIAL_CONSULT_STACIE_EVENT_PATH=initial-consults/initial-consult-stacie
NUXT_PUBLIC_CALCOM_INITIAL_CONSULT_JESSICA_EVENT_PATH=initial-consults/initial-consult-jessica
NUXT_PUBLIC_CALCOM_INITIAL_CONSULT_JAMES_EVENT_PATH=initial-consults/initial-consult-james
NUXT_PUBLIC_CALCOM_INITIAL_CONSULT_UNPUBLISHED_CONSULTANTS=jessica
# Separate mode also requires a distinct Phone route for every published option.
# These are planned paths; they do not establish provider readiness.
NUXT_PUBLIC_CALCOM_INITIAL_CONSULT_FIRST_AVAILABLE_PHONE_EVENT_PATH=initial-consults/initial-consult-phone
NUXT_PUBLIC_CALCOM_INITIAL_CONSULT_TAJ_PHONE_EVENT_PATH=initial-consults/initial-consult-taj-phone
NUXT_PUBLIC_CALCOM_INITIAL_CONSULT_STACIE_PHONE_EVENT_PATH=initial-consults/initial-consult-stacie-phone
NUXT_PUBLIC_CALCOM_INITIAL_CONSULT_JESSICA_PHONE_EVENT_PATH=
NUXT_PUBLIC_CALCOM_INITIAL_CONSULT_JAMES_PHONE_EVENT_PATH=initial-consults/initial-consult-james-phone
